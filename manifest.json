{
  "manifest_version": 3,
  "name": "Khan Grader",
  "description": "Capture Khan Academy individual student report minutes for teacher review.",
  "version": "0.16.1",
  "homepage_url": "https://github.com/humby2525/Khan-Grader",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://khanacademy.org/*",
    "https://*.khanacademy.org/*",
    "https://schoology.com/*",
    "https://*.schoology.com/*",
    "https://api.schoology.com/*"
  ],
  "action": {
    "default_title": "Khan Grader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://khanacademy.org/*",
        "https://*.khanacademy.org/*"
      ],
      "js": [
        "src/content/khanCapture.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
