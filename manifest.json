{
  "manifest_version": 3,
  "name": "Khan Grader",
  "description": "Capture Khan Academy individual student report minutes for teacher review.",
  "version": "0.16.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://khanacademy.org/*",
    "https://*.khanacademy.org/*",
    "https://schoology.com/*",
    "https://*.schoology.com/*",
    "https://api.schoology.com/*"
  ],
  "action": {
    "default_title": "Khan Grader"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://khanacademy.org/*",
        "https://*.khanacademy.org/*"
      ],
      "js": [
        "src/content/khanCapture.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
