# Configure these privately in the hosting dashboard. Never commit real values.
PUBLIC_ORIGIN=https://your-connector.example.com
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
# Comma-separated numeric Schoology section IDs from Khan Grader Setup > Classes.
SCHOOLOGY_SECTION_IDS=
# A new random password of at least 24 characters; NOT your Schoology password.
CONNECTOR_PASSWORD=
# Mount a private persistent disk here, or reconnect ChatGPT after restarts.
AUTH_DB_PATH=./private/auth.sqlite
PORT=3000
